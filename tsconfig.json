{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@game/*": ["src/game/*"],
      "@shared/*": ["src/shared/*"],
      "@/server/*": ["src/model/*"],
      "@host/*": ["src/host/*"]
    },
    "types": ["vite/client", "node", "@serwist/vite/typings"]
  },
  "include": ["src", "tests", "tools/gallery", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["src/sw.ts"]
}
