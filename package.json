{
  "name": "pawfield",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cat Emblem — тактическая игра про котиков и собачек (Telegram Mini App + PWA)",
  "scripts": {
    "dev": "vite",
    "dev:rich": "vite --mode rich",
    "build": "pnpm typecheck && vite build && cp dist/index.html dist/404.html && node tools/check-sw.mjs",
    "preview": "vite preview",
    "test:watch": "vitest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json",
    "icons": "node tools/gen-icons.mjs",
    "smoke:pwa": "node tools/smoke-pwa.mjs",
    "sync:game": "node tools/sync-game.mjs",
    "smoke": "node tools/smoke.mjs",
    "smoke:tg": "node tools/smoke-telegram.mjs"
  },
  "dependencies": {
    "@nanostores/react": "^2.0.1",
    "lz-string": "^1.5.0",
    "nanostores": "^1.5.5",
    "phaser": "^3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@serwist/vite": "^9.5.13",
    "@serwist/window": "^9.5.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "serwist": "^9.5.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.10.0"
}
