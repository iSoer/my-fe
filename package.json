{
  "name": "pawfield",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Пушистая Резня — тактическая игра про котиков и собачек (Telegram Mini App)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "test:watch": "vitest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke:combat": "node tools/smoke-combat.mjs"
  },
  "dependencies": {
    "@nanostores/preact": "^1.1.1",
    "@preact/signals": "^2.11.3",
    "lz-string": "^1.5.0",
    "nanostores": "^1.5.5",
    "phaser": "^3.90.0",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.10.0"
}
